# Environment placeholders

Copy this file to `.env` and set the Microsoft values below.
Do not put client secrets in `VITE_*` variables. Vite embeds `VITE_*` values into the
frontend JavaScript at build time, including Docker image builds.

# Database
POSTGRES_USER=forecast_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_budget_forecasting
DATABASE_URL=postgresql://forecast_admin:change_me@db:5432/ai_budget_forecasting

# API
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:5174
ORIGINAL_ACTUALS_PATH=/app/model_training_engine/dataset/historical_actuals_master.xlsx
HISTORICAL_MASTER_DATASET_PATH=/app/model_training_engine/dataset/historical_actuals_master.xlsx

# Historical dataset uploads (host folder is bind-mounted in Docker)
DATASET_STORAGE_DIR=./backend/data/dataset_files

# Microsoft Entra (frontend UI login and Settings change popup)
VITE_AZURE_TENANT_ID=YOUR_TENANT_ID
VITE_AZURE_CLIENT_ID=YOUR_SPA_APP_CLIENT_ID

# Editor permission file. Both department and job_title must match a rule.
# Mounted into the backend container. Edit the file; do not rebuild the frontend.
EDITOR_PERMISSIONS_PATH=/app/config/editor_permissions.json
